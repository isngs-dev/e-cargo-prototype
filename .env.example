# Frontend (Vite). Leave unset to keep email/SMS simulated.
VITE_NOTIFY_URL=http://localhost:8787
# Team mailbox for messages meant for demo officers / demo companies.
VITE_DEMO_INBOX=

# Notification service (npm run notify) — set in the host's environment, never commit real keys.
# Email: set BREVO_API_KEY (free, 300/day) or SENDGRID_API_KEY (paid). Brevo wins if both are set.
BREVO_API_KEY=
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=NRC e-Cargo
# SMS: Nigeria Bulk SMS (used if all three are set) or KudiSMS.
NBS_USERNAME=
NBS_PASSWORD=
NBS_SENDER=
KUDISMS_TOKEN=
KUDISMS_SENDER=
ALLOWED_ORIGINS=http://localhost:5173
